DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{QUERY_STRING} (^|&)invite=mehndi(&|$) [NC]
  RewriteRule ^$ invite/mehndi/index.html [L]
  RewriteCond %{QUERY_STRING} (^|&)invite=barat(&|$) [NC]
  RewriteRule ^$ invite/barat/index.html [L]
  RewriteCond %{QUERY_STRING} (^|&)invite=walima(&|$) [NC]
  RewriteRule ^$ invite/walima/index.html [L]
  RewriteCond %{QUERY_STRING} (^|&)invite=valima(&|$) [NC]
  RewriteRule ^$ invite/valima/index.html [L]
</IfModule>
